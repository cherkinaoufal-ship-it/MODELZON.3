VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server-only — never exposed to the browser (no VITE_ prefix).
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe webhook signing secret — Stripe Dashboard → Developers → Webhooks
# → your endpoint → "Signing secret". Required for src/routes/api/stripe-webhook.ts.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# RevenueCat (Google Play Billing on Android). The API key is public (safe
# to ship in the client bundle, hence VITE_ prefix); the webhook auth token
# is a shared secret you set yourself in the RevenueCat dashboard webhook
# config and must match exactly — required for src/routes/api/revenuecat-webhook.ts.
VITE_REVENUECAT_ANDROID_API_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
REVENUECAT_WEBHOOK_AUTH=choose-a-long-random-string-and-put-it-in-revenuecat-dashboard-too

# Optional — where to notify your print/fulfillment supplier when an order
# is paid (see the checkout.session.completed handler in
# src/routes/api/stripe-webhook.ts). Leave unset if you don't have that
# integration yet; paid orders still get recorded normally either way.
SUPPLIER_WEBHOOK_URL=
